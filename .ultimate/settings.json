{
  "instance": {
    "model": "github-copilot/gpt-6.1-sol"
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": [
      { "command": "pnpm check", "timeout": 120 },
      { "command": "pnpm test --reporter=verbose", "timeout": 300 },
      { "command": "pnpm test:e2e --reporter=verbose", "timeout": 360 }
    ],
    "push": "fork"
  }
}
